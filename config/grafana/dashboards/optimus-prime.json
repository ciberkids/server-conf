{
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds{job=\"node-optimusprime\"}",
          "instant": true,
          "legendFormat": "Optimus Prime",
          "refId": "A"
        }
      ],
      "title": "Optimus Prime - Uptime",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "up",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Prometheus Scrape Targets",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"node-optimusprime\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A"
        },
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{job=\"node-optimusprime\"} / node_memory_MemTotal_bytes{job=\"node-optimusprime\"}) * 100",
          "legendFormat": "Memory %",
          "refId": "B"
        }
      ],
      "title": "Optimus Prime - CPU / Memory / Load",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 5,
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=\"node-optimusprime\",device=\"enp7s0\"}[5m])",
          "legendFormat": "RX",
          "refId": "A"
        },
        {
          "expr": "-rate(node_network_transmit_bytes_total{job=\"node-optimusprime\",device=\"enp7s0\"}[5m])",
          "legendFormat": "TX",
          "refId": "B"
        }
      ],
      "title": "Optimus Prime - Network Traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
