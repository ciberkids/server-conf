      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "afgw1dyxyshz4b"
          },
          "expr": "node_drm_gpu_busy_percent{instance=\"optimusprime\",card=\"card1\"}",
          "legendFormat": "GPU Busy %",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "afgw1dyxyshz4b"
          },
          "expr": "node_drm_memory_vram_used_bytes{instance=\"optimusprime\",card=\"card1\"} / node_drm_memory_vram_size_bytes{instance=\"optimusprime\",card=\"card1\"} * 100",
          "legendFormat": "VRAM Used %",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "afgw1dyxyshz4b"
          },
          "expr": "node_drm_memory_gtt_used_bytes{instance=\"optimusprime\",card=\"card1\"} / node_drm_memory_gtt_size_bytes{instance=\"optimusprime\",card=\"card1\"} * 100",
          "legendFormat": "GTT Used %",
          "refId": "C"
        }
      ],
      "title": "AMD GPU",
      "type": "timeseries"
    },
    {
      "description": "md device resolved from the filesystem mounted at /mnt/data, NOT a hardcoded md number: md124..md127 are assigned at assembly and swap across reboots (seen 2026-10-28). 'active' falls back to 0 (red) when nothing is mounted there, i.e. the array failed to assemble or mount. The legend on 'required' shows the md number currently backing it.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
