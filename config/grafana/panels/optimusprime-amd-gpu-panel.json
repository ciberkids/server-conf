{
  "id": 7,
  "type": "timeseries",
  "title": "AMD GPU",
  "description": "WARNING: gpu_busy_percent does NOT measure the VCN video encoder. Verified 2026-09-03: a saturated hevc_vaapi encode ran at 96.5% encoder duty (DRM fdinfo drm-engine-enc) while this gauge read a mean of 18% and drm-engine-gfx read 0.0% - a 5.36x under-report. It is also quantised to integer 0-100 and point-sampled every 30s, so a real-time 1080p30 transcode (~15% encoder duty) reads ~1. Three compounding faults: wrong engine, quantisation, aliasing. The envelope series below mitigates only the third. The real fix is a monotonic amdgpu_engine_busy_seconds_total{engine=\"enc\"} counter from DRM fdinfo, where rate() is exact at any scrape interval. VRAM/GTT are in BYTES on the right axis - as a percentage of the 8.5 GB pool they peak at 2.8% and look flat. See docs/homelab-fix-list.md section 1.",
  "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 30
  },
  "fieldConfig": {
    "defaults": {
      "min": 0,
      "unit": "percent",
      "custom": {
        "fillOpacity": 10,
        "lineWidth": 2,
        "axisPlacement": "left"
      }
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "GPU Busy % (rate-interval max)"
        },
        "properties": [
          {
            "id": "max",
            "value": 100
          },
          {
            "id": "unit",
            "value": "percent"
          },
          {
            "id": "custom.axisPlacement",
            "value": "left"
          },
          {
            "id": "custom.axisLabel",
            "value": "GPU busy %"
          },
          {
            "id": "custom.fillOpacity",
            "value": 18
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "GPU Busy % (raw 30s sample)"
        },
        "properties": [
          {
            "id": "max",
            "value": 100
          },
          {
            "id": "unit",
            "value": "percent"
          },
          {
            "id": "custom.axisPlacement",
            "value": "left"
          },
          {
            "id": "custom.fillOpacity",
            "value": 0
          },
          {
            "id": "custom.lineWidth",
            "value": 1
          },
          {
            "id": "custom.lineStyle",
            "value": {
              "fill": "dash",
              "dash": [
                8,
                4
              ]
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byRegexp",
          "options": "/(VRAM|GTT) used/"
        },
        "properties": [
          {
            "id": "unit",
            "value": "bytes"
          },
          {
            "id": "custom.axisPlacement",
            "value": "right"
          },
          {
            "id": "custom.axisLabel",
            "value": "VRAM / GTT"
          },
          {
            "id": "custom.fillOpacity",
            "value": 6
          }
        ]
      }
    ]
  },
  "options": {
    "legend": {
      "displayMode": "table",
      "placement": "bottom",
      "calcs": [
        "max",
        "mean",
        "lastNotNull"
      ]
    },
    "tooltip": {
      "mode": "multi",
      "sort": "desc"
    }
  },
  "targets": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "refId": "A",
      "expr": "max_over_time(node_drm_gpu_busy_percent{instance=\"optimusprime\",card=\"card1\"}[$__rate_interval])",
      "legendFormat": "GPU Busy % (rate-interval max)"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "refId": "B",
      "expr": "node_drm_gpu_busy_percent{instance=\"optimusprime\",card=\"card1\"}",
      "legendFormat": "GPU Busy % (raw 30s sample)"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "refId": "C",
      "expr": "node_drm_memory_vram_used_bytes{instance=\"optimusprime\",card=\"card1\"}",
      "legendFormat": "VRAM used"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "afgw1dyxyshz4b"
      },
      "refId": "D",
      "expr": "node_drm_memory_gtt_used_bytes{instance=\"optimusprime\",card=\"card1\"}",
      "legendFormat": "GTT used"
    }
  ]
}
