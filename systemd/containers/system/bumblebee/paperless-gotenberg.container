[Unit]
OnFailure=notify-failure@%n.service
Description=Paperless-NGX Gotenberg PDF converter
Requires=network-online.target

[Container]
ContainerName=paperless-gotenberg
Network=paperless.network
# Version and flags follow upstream paperless-ngx docker-compose.postgres-tika.yml.
Image=docker.io/gotenberg/gotenberg:8.38
Volume=/etc/localtime:/etc/localtime:ro

# Chromium renders .eml files: no JavaScript, and only local temp files.
# The ^ anchor matters: unanchored, any URL merely containing file:///tmp/ matched.
Exec=gotenberg --chromium-disable-javascript=true --chromium-allow-list=^file:///tmp/.*

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
