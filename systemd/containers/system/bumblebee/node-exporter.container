[Unit]
OnFailure=notify-failure@%n.service
Description=Prometheus Node Exporter
Requires=network-online.target

[Container]
ContainerName=node-exporter
Image=quay.io/prometheus/node-exporter:latest
Network=host
SecurityLabelDisable=true
Volume=/etc/localtime:/etc/localtime:ro
Volume=/:/host:ro,rslave
PodmanArgs=--pid=host
Environment=NODE_ID=bumblebee
# systemd collector reads unit states over the host's system D-Bus via the /host bind mount
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket
Exec=--path.rootfs=/host --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/) --collector.textfile.directory=/host/tmp/node_exporter --collector.systemd

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
