[Unit]
OnFailure=notify-failure@%n.service
Description=Paperless-NGX Redis broker
Requires=network-online.target

[Container]
ContainerName=paperless-broker
Network=paperless.network
Image=docker.io/library/redis:8
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/matteo/docker_persistent/paperless/redis:/data:rw,Z

HealthCmd=redis-cli ping
# 10s -> 30s on 2026-07-27; see paperless-db.container for the full rationale. podman emits
# a health_status syslog line on every check, and nothing here consumes the fast signal.
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
