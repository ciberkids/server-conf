[Unit]
OnFailure=notify-failure@%n.service
OnSuccess=notify-success@%n.service
Description=Ollama LLM Server
Requires=network-online.target
After=nvidia-cdi-refresh.service

[Container]
ContainerName=ollama
Image=docker.io/ollama/ollama:latest
PublishPort=11434:11434
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/matteo/docker_persistent/ollama:/root/.ollama:rw,Z
AddDevice=nvidia.com/gpu=all

Environment=OLLAMA_GPU_OVERHEAD=0
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1

AutoUpdate=registry

Label=traefik.enable=true
Label=traefik.http.routers.ollama.rule=Host(`ollama.bumblebee.favarohome.com`)
Label=traefik.http.routers.ollama.entrypoints=websecure
Label=traefik.http.routers.ollama.tls.certresolver=cloudflare
Label=traefik.http.services.ollama.loadbalancer.server.port=11434

[Service]
Restart=always
# Bumblebee has 16 GB, shared with Frigate (~3.4 GB). On 2026-10-19 a model load
# took ollama 1.25 -> 5.4 GB in 4 min (layers spilling off the 1080 Ti to CPU),
# MemAvailable hit 1 GB and the host livelocked for 17 h (no OOM kill, sshd dead,
# ping alive). Cap it so a too-big load OOM-kills ollama, not the whole box.
# The container cgroup is a child of this unit's (--cgroups=split), so this applies.
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=0

[Install]
WantedBy=default.target
