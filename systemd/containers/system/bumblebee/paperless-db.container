[Unit]
OnFailure=notify-failure@%n.service
Description=Paperless-NGX PostgreSQL database
Requires=network-online.target

[Container]
ContainerName=paperless-db
Network=paperless.network
Image=docker.io/library/postgres:18
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/matteo/docker_persistent/paperless/postgres:/var/lib/postgresql:rw,Z

Environment=POSTGRES_DB=paperless
Environment=POSTGRES_USER=paperless
EnvironmentFile=/etc/containers/secrets/paperless.env

HealthCmd=pg_isready -U paperless -d paperless
# 5s -> 30s on 2026-07-27. podman logs a health_status line to syslog on EVERY check, not
# only on state changes (unlike docker), so 5s meant 17,280 x ~330-byte lines/day from this
# one container -- the single largest contributor to log volume once Traefik's API access
# log was silenced. Nothing consumes the fast signal: there is no Notify= (systemd is not
# gated on health) and no HealthOnFailure=, so the check only sets an informational label.
# 30s matches paperless.container. Worst-case detection is HealthRetries x HealthInterval
# = 150s; raise the interval further only if you accept slower detection.
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
