[Unit]
OnFailure=notify-failure@%n.service
Description=Firefly III personal finance manager
Requires=network-online.target
After=firefly-iii-db.service

[Container]
ContainerName=firefly-iii
Network=firefly-iii.network
Image=docker.io/fireflyiii/core:latest
PublishPort=8006:8080
Volume=/etc/localtime:/etc/localtime:ro
Volume=/mnt/data/docker_persistent/firefly-iii/upload:/var/www/html/storage/upload:rw

Environment=APP_ENV=production
Environment=APP_DEBUG=false
Environment=SITE_OWNER=matteo@favarohome.com
Environment=DEFAULT_LANGUAGE=en_US
Environment=DEFAULT_LOCALE=equal
Environment=TZ=Europe/Zurich
Environment=TRUSTED_PROXIES=**
Environment=APP_URL=https://firefly.optimusprime.favarohome.com
Environment=DB_CONNECTION=mysql
Environment=DB_HOST=firefly-iii-db
Environment=DB_PORT=3306
Environment=DB_DATABASE=firefly
Environment=DB_USERNAME=firefly
EnvironmentFile=/etc/containers/secrets/firefly-iii.env

AutoUpdate=registry

HealthCmd=CMD-SHELL curl -sf -o /dev/null http://localhost:8080/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=120s
HealthTimeout=10s
HealthOnFailure=restart

# Routing is via the FILE provider, not labels. This container is on the
# `firefly-iii` network (10.89.2.x) for DB DNS; Traefik is on `podman`
# (10.88.0.x) and has no route there, so label routing gave Traefik an
# unreachable backend -- 20s hangs, nothing logged, dashboard said "UP".
# See config/traefik/optimusprime/dynamic.yml -> 192.168.1.10:8006
# Do NOT set this back to true: the @docker router would collide with the @file
# router on the same Host() rule at equal priority, winner non-deterministic.
Label=traefik.enable=false

[Service]
Restart=always

[Install]
WantedBy=default.target
