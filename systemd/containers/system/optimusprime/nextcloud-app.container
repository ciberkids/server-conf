[Unit]
OnFailure=notify-failure@%n.service
Description=Nextcloud container
Requires=nextcloud-db.service
# Requires= alone starts these in parallel; After= makes the app wait for the database
After=nextcloud-db.service

[Container]
ContainerName=nextcloud-app
Pod=nextcloud.pod
Image=docker.io/linuxserver/nextcloud:latest
Volume=/etc/localtime:/etc/localtime:ro
Volume=/mnt/data/docker_persistent/nextcloud:/config:rw
Volume=/mnt/data/docker_persistent/nextcloud/data:/data:rw
Environment=TZ=Europe/Zurich
Environment="PGID=1000"
Environment="PUID=1000"

AutoUpdate=registry

HealthCmd=CMD-SHELL curl -sfk -o /dev/null https://localhost:443/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=120s
HealthTimeout=10s
HealthOnFailure=restart

[Service]
Restart=always
# give the database time to accept connections instead of burning retries at the 100ms default
RestartSec=10

[Install]
WantedBy=default.target
