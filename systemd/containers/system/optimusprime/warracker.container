[Unit]
OnFailure=notify-failure@%n.service
Description=Warracker warranty tracker
Requires=network-online.target
After=warracker-db.service

[Container]
ContainerName=warracker
Network=warracker.network
Image=ghcr.io/sassanix/warracker/main:latest
PublishPort=8005:80
Volume=/etc/localtime:/etc/localtime:ro
Volume=/mnt/data/docker_persistent/warracker/uploads:/data/uploads:rw

Environment=DB_HOST=warracker-db
Environment=DB_NAME=warranty_db
Environment=DB_USER=warranty_user
Environment=FRONTEND_URL=https://warracker.optimusprime.favarohome.com
Environment=APP_BASE_URL=https://warracker.optimusprime.favarohome.com
Environment=FLASK_ENV=production
Environment=WARRACKER_MEMORY_MODE=optimized
Environment=MAX_UPLOAD_MB=32
EnvironmentFile=/etc/containers/secrets/warracker.env

AutoUpdate=registry

HealthCmd=CMD-SHELL curl -sf -o /dev/null http://localhost:80/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=10s
HealthOnFailure=restart

# Routing is via the FILE provider, not labels. This container is on the
# `warracker` network (10.89.1.x) so DB_HOST=warracker-db resolves; Traefik is on
# `podman` (10.88.0.x) and has no route there. Label-based routing therefore gave
# Traefik a backend it could never reach -- 20s hangs, nothing logged, dashboard
# said "UP". See config/traefik/optimusprime/dynamic.yml -> 192.168.1.10:8005
# Do NOT set this back to true: the @docker router would collide with the @file
# router on the same Host() rule at equal priority, winner non-deterministic.
Label=traefik.enable=false

[Service]
Restart=always

[Install]
WantedBy=default.target
