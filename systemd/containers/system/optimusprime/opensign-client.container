[Unit]
OnFailure=notify-failure@%n.service
Description=OpenSign Web Client
Requires=network-online.target
After=opensign-server.service

[Container]
ContainerName=opensign-client
Network=opensign.network
Image=docker.io/opensign/opensign:main
PublishPort=3001:3000
Volume=/etc/localtime:/etc/localtime:ro

Environment=REACT_APP_SERVERURL=https://opensign-api.optimusprime.favarohome.com/app
Environment=PUBLIC_URL=https://opensign.optimusprime.favarohome.com

AutoUpdate=registry

HealthCmd=CMD-SHELL curl -sf -o /dev/null http://localhost:3000/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=10s
HealthOnFailure=restart

# Routing is via the FILE provider, not labels. This container is on the
# `opensign` network (10.89.0.x) to reach opensign-server/opensign-db by name;
# Traefik is on `podman` (10.88.0.x) and has no route there, so label routing
# gave Traefik an unreachable backend -- 20s hangs, nothing logged, "UP".
# See config/traefik/optimusprime/dynamic.yml -> 192.168.1.10:3001
# Do NOT set this back to true: the @docker router would collide with the @file
# router on the same Host() rule at equal priority, winner non-deterministic.
Label=traefik.enable=false

[Service]
Restart=always

[Install]
WantedBy=default.target
