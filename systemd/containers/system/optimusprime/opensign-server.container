[Unit]
OnFailure=notify-failure@%n.service
Description=OpenSign API Server
Requires=network-online.target
After=opensign-db.service

[Container]
ContainerName=opensign-server
Network=opensign.network
Image=docker.io/opensign/opensignserver:main
PublishPort=8081:8080
Volume=/etc/localtime:/etc/localtime:ro
Volume=/mnt/data/docker_persistent/opensign/files:/usr/src/app/files/files:rw

Environment=MONGODB_URI=mongodb://opensign-db:27017/OpenSignDB
Environment=SERVER_URL=https://opensign-api.optimusprime.favarohome.com/app
Environment=PUBLIC_URL=https://opensign.optimusprime.favarohome.com
Environment=USE_LOCAL=true
EnvironmentFile=/etc/containers/secrets/opensign.env

AutoUpdate=registry

HealthCmd=CMD-SHELL curl -sf -o /dev/null http://localhost:8080/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=10s
HealthOnFailure=restart

# Routing is via the FILE provider, not labels. This container is on the
# `opensign` network (10.89.0.x) for inter-container DNS; Traefik is on `podman`
# (10.88.0.x) and has no route there, so label routing gave Traefik an
# unreachable backend -- 20s hangs, nothing logged, dashboard said "UP".
# NOTE the hostname here is opensign-api.*, not opensign.*
# See config/traefik/optimusprime/dynamic.yml -> 192.168.1.10:8081
# Do NOT set this back to true: the @docker router would collide with the @file
# router on the same Host() rule at equal priority, winner non-deterministic.
Label=traefik.enable=false

[Service]
Restart=always

[Install]
WantedBy=default.target
