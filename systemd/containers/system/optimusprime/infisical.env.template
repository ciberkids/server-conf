# Copy to /etc/containers/secrets/infisical.env on optimusprime (root:root, 0600).
# BOOTSTRAP SECRETS: hand-managed, never by an Infisical agent. Back up ENCRYPTION_KEY and
# AUTH_SECRET outside the homelab (LastPass): a DB backup is useless without ENCRYPTION_KEY.
ENCRYPTION_KEY=<openssl rand -hex 16  (32 hex chars)>
AUTH_SECRET=<openssl rand -base64 32  (44 chars)>
DB_CONNECTION_URI=postgres://infisical:<POSTGRES_PASSWORD>@infisical-db:5432/infisical
REDIS_URL=redis://infisical-redis:6379
