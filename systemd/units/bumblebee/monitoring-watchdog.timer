[Unit]
Description=Run the cross-host monitoring watchdog every 15 minutes

[Timer]
# Wall-clock, NOT OnBootSec+OnUnitActiveSec. The monotonic pair only chains once
# OnBootSec has fired, so enabling it on an already-running host leaves
# `systemctl list-timers` showing NEXT="-" and it never runs until the next reboot,
# while `enable --now` still reports success. Verified the hard way on OP's
# slzb-temp-logger.timer. OnCalendar needs no activation chain.
OnCalendar=*:0/15
AccuracySec=30s
# Fire once on boot if a run was missed while the host was down.
Persistent=true

[Install]
WantedBy=timers.target
