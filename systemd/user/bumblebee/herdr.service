# herdr headless server as a systemd USER service for matteo on Bumblebee.
# Deploy: ~/.config/systemd/user/herdr.service, then `loginctl enable-linger matteo`
# (so it starts at boot and survives logout) and `systemctl --user enable --now herdr`.
# Clients (`herdr` over SSH) attach through ~/.config/herdr/herdr.sock.
# After `herdr update`, run `systemctl --user restart herdr` to load the new binary
# (this ends pane processes; herdr restores the layout and resumes agents on attach).
[Unit]
Description=herdr headless server (workspace manager for AI coding agents)
Documentation=https://herdr.dev/tui/docs/persistence-remote/

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/herdr server
# The user manager's PATH lacks ~/.local/bin, so panes could not find claude/herdr.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
# SIGTERM to herdr only: it saves the session and stops its panes itself.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
